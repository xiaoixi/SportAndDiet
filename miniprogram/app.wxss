page{--sun-accent:#ec7438;--sun-text:#242426;--sun-secondary:#77777f;--sun-surface:#fff;--sun-soft:#fff0e5;--sun-line:#eeeef1;background:#f5f5f7;color:var(--sun-text);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","PingFang SC",sans-serif;font-size:28rpx;line-height:1.55}
view,text,button,input,textarea{box-sizing:border-box}button::after{border:0}button{font-size:27rpx;border-radius:48rpx;margin:0;padding:23rpx 30rpx;line-height:1.4;font-weight:600}button[disabled]{opacity:.42}button:active{opacity:.85}input,textarea{background:#f5f5f7;border-radius:22rpx;padding:23rpx;width:100%;font-size:28rpx;color:var(--sun-text)}input{height:92rpx}textarea{min-height:170rpx}
.page{padding:34rpx 40rpx 64rpx;min-height:100vh;background:linear-gradient(180deg,#fff8ec 0,#f5f5f7 620rpx)}.tab-page{padding-bottom:calc(190rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#9a8d7e;text-transform:uppercase}.title{font-size:62rpx;line-height:1.23;font-weight:700;letter-spacing:-2rpx;margin:18rpx 0}.subtitle,.muted{color:var(--sun-secondary);font-size:25rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.wrap{flex-wrap:wrap}.top{align-items:flex-start}
.card{background:var(--sun-surface);border:0;border-radius:42rpx;padding:34rpx;margin-top:26rpx}.hero{background:linear-gradient(135deg,#ffe9c5,#ffdabf);color:#322b24;padding:38rpx;position:relative;overflow:hidden}.hero .muted{color:#88603f}.hero-title{font-size:44rpx;line-height:1.3;font-weight:650;letter-spacing:-1rpx;margin:24rpx 0 12rpx}.tag{display:inline-block;border-radius:24rpx;padding:7rpx 17rpx;background:var(--sun-soft);font-size:22rpx;color:#a45428}.hero .tag{background:rgba(255,255,255,.68);color:#935527}.section{font-size:36rpx;font-weight:650;letter-spacing:-.5rpx;margin:42rpx 0 20rpx}.section .muted{font-size:23rpx;font-weight:400;letter-spacing:0}.primary,.dark{background:#242426;color:#fff}.secondary{background:var(--sun-soft);color:#a3542c}.danger{background:#fff0eb;color:#a7432b}.link{color:#b75625;font-size:25rpx;background:transparent;padding:10rpx}.space{margin-top:26rpx}.small{font-size:23rpx}.big{font-size:60rpx;font-weight:700;line-height:1.2;letter-spacing:-1.5rpx}.metric{flex:1;min-width:0}.metric+.metric{border-left:1rpx solid var(--sun-line);padding-left:24rpx}.bar{height:10rpx;background:#f8e9df;border-radius:10rpx;overflow:hidden;margin-top:22rpx}.fill{height:100%;background:var(--sun-accent);border-radius:inherit}.divider{border-top:1rpx solid var(--sun-line);margin:25rpx 0}.hero .divider{border-color:rgba(147,85,39,.12)}
.pill{background:#f5f5f7;border:1rpx solid transparent;padding:15rpx 25rpx;border-radius:34rpx;font-size:24rpx;display:inline-block;margin:7rpx 5rpx}.pill.active{background:var(--sun-accent);color:#fff}.label{display:block;font-size:26rpx;font-weight:600;margin:28rpx 0 14rpx}.notice{background:#fff0d8;color:#8e652e;border-radius:26rpx;padding:24rpx;font-size:24rpx;margin-top:24rpx}.empty{text-align:center;padding:54rpx 24rpx;color:var(--sun-secondary)}.list-item{padding:27rpx 0;border-bottom:1rpx solid var(--sun-line)}.list-item:last-child{border:0}.icon{width:80rpx;height:80rpx;border-radius:25rpx;background:#fff1e4;color:#d17d38;display:flex;align-items:center;justify-content:center;font-size:35rpx;flex-shrink:0}.grow{flex:1;min-width:0}.actions{display:flex;gap:16rpx;margin-top:26rpx}.actions button{flex:1}.caption{font-size:22rpx;color:#85858d;margin-top:20rpx}.number{font-variant-numeric:tabular-nums}.week{display:flex;gap:8rpx;margin:28rpx 0}.day{flex:1;min-width:0;text-align:center;padding:20rpx 0;border-radius:28rpx;background:#fff;font-size:22rpx;color:#929096}.day.active{background:var(--sun-accent);color:#fff}.day-num{display:block;font-size:30rpx;font-weight:600;margin:8rpx 0}.dot{font-size:18rpx;color:#c9733c;min-height:26rpx}.day.active .dot{color:#fff4e8}.summary{background:#ffefdc}.check{min-width:90rpx;text-align:center}.exercise-image{width:100%;height:240rpx;background:#fff4e7;border-radius:28rpx}.weight-bars{height:200rpx;display:flex;align-items:flex-end;gap:12rpx;margin:28rpx 0}.weight-col{flex:1;text-align:center;font-size:20rpx}.weight-bar{background:#f5bb86;border-radius:12rpx 12rpx 0 0;min-height:8rpx}.badge{width:100rpx;height:100rpx;border-radius:32rpx;background:#ffe5bf;color:#a66027;font-size:43rpx;display:flex;align-items:center;justify-content:center}.footer-note{text-align:center;font-size:22rpx;color:#8b8580;margin-top:36rpx}
