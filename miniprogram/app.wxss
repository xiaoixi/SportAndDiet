page{background:#f6f7f2;color:#203c30;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}view,text,button,input,textarea{box-sizing:border-box}button::after{border:0}button{font-size:27rpx;border-radius:22rpx;margin:0;padding:20rpx 28rpx;line-height:1.4;font-weight:600}button[disabled]{opacity:.45}input,textarea{background:#f3f5f0;border-radius:16rpx;padding:22rpx;width:100%;font-size:28rpx}input{height:88rpx}textarea{min-height:160rpx}.page{padding:30rpx 32rpx 60rpx}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#829084;text-transform:uppercase}.title{font-size:52rpx;line-height:1.3;font-weight:700;letter-spacing:-2rpx;margin:12rpx 0}.subtitle,.muted{color:#7a867e;font-size:25rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.wrap{flex-wrap:wrap}.top{align-items:flex-start}.card{background:#fff;border:1rpx solid #e9ece4;border-radius:30rpx;padding:30rpx;margin-top:24rpx}.hero{background:#234e3b;color:#fff;border:0;padding:36rpx;position:relative;overflow:hidden}.hero .muted{color:#c8d8ce}.hero-title{font-size:43rpx;font-weight:650;margin:18rpx 0}.tag{display:inline-block;border-radius:12rpx;padding:6rpx 14rpx;background:#edf2e8;font-size:22rpx;color:#456149}.hero .tag{background:#41664e;color:#e4f0d6}.section{font-size:32rpx;font-weight:650;margin:34rpx 0 12rpx}.primary{background:#c5e68c;color:#203c30}.dark{background:#234e3b;color:#fff}.secondary{background:#edf2e8;color:#355741}.danger{background:#fff0eb;color:#a7432b}.link{color:#4d7256;font-size:25rpx;background:transparent;padding:8rpx}.space{margin-top:24rpx}.small{font-size:23rpx}.big{font-size:56rpx;font-weight:700;line-height:1.2}.metric{flex:1}.metric+.metric{border-left:1rpx solid #e5eae2;padding-left:24rpx}.bar{height:12rpx;background:#e8eedf;border-radius:10rpx;overflow:hidden;margin-top:20rpx}.fill{height:100%;background:#7eaa53;border-radius:10rpx}.divider{border-top:1rpx solid #edf0e8;margin:24rpx 0}.pill{background:#fff;border:1rpx solid #e1e7da;padding:12rpx 24rpx;border-radius:30rpx;font-size:24rpx;display:inline-block;margin:6rpx}.pill.active{background:#234e3b;color:#fff;border-color:#234e3b}.label{display:block;font-size:26rpx;font-weight:600;margin:24rpx 0 12rpx}.notice{background:#f0ecd9;color:#77652d;border-radius:18rpx;padding:20rpx;font-size:24rpx;margin-top:24rpx}.empty{text-align:center;padding:50rpx 24rpx;color:#7a867e}.list-item{padding:22rpx 0;border-bottom:1rpx solid #eef0ea}.list-item:last-child{border:0}.icon{width:82rpx;height:82rpx;border-radius:22rpx;background:#f2ecd9;display:flex;align-items:center;justify-content:center;font-size:36rpx;flex-shrink:0}.grow{flex:1}.actions{display:flex;gap:16rpx;margin-top:24rpx}.actions button{flex:1}.caption{font-size:22rpx;color:#8a948a;margin-top:18rpx}.number{font-variant-numeric:tabular-nums}.week{display:flex;gap:8rpx;margin:24rpx 0}.day{flex:1;text-align:center;padding:18rpx 0;border-radius:20rpx;background:#fff;border:1rpx solid #e8ece3;font-size:22rpx}.day.active{background:#234e3b;color:#fff}.day-num{display:block;font-size:30rpx;font-weight:600}.dot{font-size:18rpx;color:#82a650;min-height:26rpx}.summary{background:#eaf0df}.check{min-width:90rpx;text-align:center}.exercise-image{width:100%;height:220rpx;background:#edf2e8;border-radius:20rpx}.weight-bars{height:180rpx;display:flex;align-items:flex-end;gap:12rpx;margin:24rpx 0}.weight-col{flex:1;text-align:center;font-size:20rpx}.weight-bar{background:#b4d783;border-radius:10rpx 10rpx 0 0;min-height:8rpx}.badge{width:96rpx;height:96rpx;border-radius:30rpx;background:#c5e68c;color:#234e3b;font-size:42rpx;display:flex;align-items:center;justify-content:center}.footer-note{text-align:center;font-size:22rpx;color:#8c968c;margin-top:36rpx}
