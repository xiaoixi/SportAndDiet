<view class="tab-shell"><view class="tab-capsule"><button wx:for="{{tabs}}" wx:key="path" class="tab-item {{selected === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="select" aria-label="{{item.text}}{{selected === index ? '，当前页面' : ''}}"><image src="/assets/tabbar/{{item.icon}}{{selected === index ? '-active' : ''}}.png" mode="aspectFit" class="tab-icon"/><text>{{item.text}}</text></button></view></view>
