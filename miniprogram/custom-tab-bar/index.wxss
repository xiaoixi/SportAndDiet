:host{position:relative;z-index:100}.tab-shell{position:fixed;z-index:100;bottom:0;left:0;right:0;padding:14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,rgba(245,245,247,0),rgba(245,245,247,.96) 32%)}.tab-capsule{display:flex;align-items:center;justify-content:space-around;border-radius:52rpx;border:1rpx solid #eeeef1;background:#fff;box-shadow:0 8rpx 32rpx rgba(32,25,18,.05);padding:12rpx 10rpx}.tab-item{display:flex;flex-direction:column;align-items:center;gap:7rpx;width:132rpx;min-height:96rpx;margin:0;padding:13rpx 10rpx;border:0;border-radius:40rpx;background:transparent;color:#8b8b93;font-size:20rpx;line-height:1.2;font-weight:400}.tab-item::after{border:0}.tab-item.selected{color:#b85a28;background:#fff0e5;font-weight:600}.tab-icon{width:43rpx;height:43rpx}
