.today-page{padding-top:22rpx}.today-greeting{min-height:74rpx}.today-date{color:#827a73;font-size:25rpx}.today-sun{width:70rpx;height:70rpx;padding:12rpx;border-radius:50%;background:#ffe8c4}.today-page .title{margin-top:12rpx;font-size:61rpx}.today-week{display:flex;justify-content:space-between;gap:8rpx;margin:34rpx 0 30rpx}.today-day{flex:1;min-width:0;display:flex;align-items:center;flex-direction:column;gap:12rpx;padding:17rpx 3rpx;color:#97918a;font-size:21rpx;border-radius:28rpx}.today-day-number{color:#625c56;font-size:28rpx;font-weight:500}.today-day.current{background:#fff;box-shadow:0 6rpx 22rpx rgba(160,106,42,.06);color:#c56831}.today-day.current .today-day-number{color:#c56831;font-weight:650}.today-workout{margin-top:0;padding:38rpx}.today-front{position:relative;z-index:1}.sun-halo{position:absolute;right:-65rpx;top:5rpx;width:330rpx;height:330rpx;border:25rpx solid rgba(255,232,162,.3);border-radius:50%;background:rgba(255,227,159,.35)}.sun-halo::before{content:"";position:absolute;top:27rpx;right:27rpx;bottom:27rpx;left:27rpx;border:20rpx solid rgba(255,223,153,.55);border-radius:50%;background:rgba(255,245,192,.6)}.workout-status{color:#8d5c37;font-size:23rpx}.today-workout .hero-title{margin-top:38rpx;font-size:47rpx}.today-workout .primary{margin-top:38rpx}.button-arrow{margin-left:10rpx}.today-diet{margin-top:0;padding:34rpx}.today-nutrition{padding-bottom:28rpx}.meal-count{display:flex;flex-direction:column;gap:5rpx;align-items:center;background:#fff3e9;color:#aa572c;padding:17rpx 20rpx;border-radius:24rpx;font-size:27rpx;font-weight:600}.meal-count-label{font-size:19rpx;font-weight:400}.today-meal{padding:26rpx 0;border-top:1rpx solid #f0f0f2}.meal-description{font-size:22rpx;margin-top:5rpx}.meal-end{color:#85858c;font-size:22rpx;white-space:nowrap}.meal-recorded{color:#b65b2c}.diet-estimate{border-top:1rpx solid #f0f0f2;padding-top:22rpx;margin-top:0}.plan-reason{padding:0 8rpx}
.today-workout .primary { width: 100%; }
.weight-card{margin-top:0;--weight-tone:#b85a28;--weight-ink:#84512f;--weight-tint:#fff0e5;--weight-line:#f0ded0;--weight-soft:#ffe5bf;background:#fff;border:1rpx solid #eee9e4;padding:40rpx}
.weight-card.closer{--weight-tone:#147d49;--weight-ink:#155c38;--weight-tint:#e1f5e7;--weight-line:#b5ddc1;--weight-soft:#c4e9d0;background:linear-gradient(140deg,#e1f5e7,#f2fcf4);border-color:#b5ddc1}
.weight-card.away{--weight-tone:#cb4655;--weight-ink:#96333e;--weight-tint:#ffe3e5;--weight-line:#efb5bb;--weight-soft:#fac7ce;background:linear-gradient(140deg,#ffe3e5,#fff4f4);border-color:#efb5bb}
.weight-label{font-size:25rpx;color:var(--weight-ink);font-weight:500}.weight-status{color:#fff;background:var(--weight-tone);border-radius:28rpx;font-size:22rpx;padding:9rpx 20rpx}.unrecorded .weight-status,.neutral .weight-status{color:#946b4b;background:#fff0e5}
.weight-value-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:46rpx 0 42rpx;color:var(--weight-ink)}.weight-input-row{display:flex;align-items:baseline;gap:8rpx;flex:1;min-width:0}
.weight-card .weight-input{font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",sans-serif;background:transparent;border-radius:0;padding:0;font-size:92rpx;line-height:1.15;letter-spacing:-3rpx;font-weight:700;color:var(--weight-ink);width:300rpx;min-width:0;height:112rpx}.weight-placeholder{font-size:40rpx;font-weight:400;letter-spacing:0;color:#a3958d}.weight-unit{font-size:28rpx;opacity:.65;flex-shrink:0}
.weight-mood{width:112rpx;height:112rpx;border-radius:50%;background:var(--weight-soft);display:flex;align-items:center;justify-content:center;flex-shrink:0}.weight-mood image{width:69rpx;height:69rpx}
.weight-feedback{color:var(--weight-ink);margin-bottom:38rpx}.same .weight-feedback,.neutral .weight-feedback{background:var(--weight-tint);padding:28rpx;border-radius:30rpx}.weight-message{font-size:33rpx;font-weight:650;letter-spacing:-.5rpx;line-height:1.4;margin-bottom:10rpx}.weight-detail{font-size:24rpx;line-height:1.65}
.weight-meta{display:flex;justify-content:space-between;gap:16rpx;flex-wrap:wrap;color:var(--weight-ink);font-size:22rpx;border-top:1rpx solid var(--weight-line);padding-top:28rpx;margin-bottom:34rpx}.weight-save{width:100%}.weight-distance{text-align:center;font-size:22rpx;color:var(--weight-ink);margin-top:22rpx}.weight-note{font-size:21rpx;color:#938984;margin:18rpx 6rpx 0}

.weight-celebration{position:fixed;z-index:300;top:0;right:0;bottom:0;left:0;pointer-events:none;overflow:hidden}.celebration-particles{position:absolute;top:0;right:0;bottom:0;left:0;pointer-events:none}.celebration-spark{position:absolute;width:8rpx;height:23rpx;border-radius:8rpx;opacity:0;animation:weight-firework 2100ms ease-out both;will-change:transform,opacity}.celebration-flower{position:absolute;opacity:0;animation:weight-blossom 2800ms ease-out both;will-change:transform,opacity}.celebration-message{position:absolute;top:18%;left:38rpx;right:38rpx;padding:26rpx 30rpx;text-align:center;border:1rpx solid rgba(237,212,183,.65);border-radius:32rpx;background:rgba(255,250,242,.97);box-shadow:0 12rpx 48rpx rgba(117,74,36,.08);animation:weight-celebration-message 3300ms ease both}.fireworks .celebration-message{background:rgba(244,255,247,.97);border-color:#cce5d4}.celebration-title{font-size:34rpx;font-weight:650;line-height:1.4;color:#84512f}.fireworks .celebration-title{color:#236a43}.celebration-detail{font-size:23rpx;line-height:1.6;color:#88766a;margin-top:8rpx}
@keyframes weight-firework{0%{opacity:0;transform:translate3d(0,80rpx,0) scale(.15) rotate(var(--spark-angle))}12%{opacity:1;transform:translate3d(0,0,0) scale(.7) rotate(var(--spark-angle))}75%{opacity:.9}100%{opacity:0;transform:translate3d(var(--spark-x),var(--spark-y),0) scale(.25) rotate(var(--spark-angle))}}
@keyframes weight-blossom{0%{opacity:0;transform:translate3d(0,160rpx,0) rotate(-25deg) scale(.25)}18%{opacity:1}70%{opacity:1}100%{opacity:0;transform:translate3d(var(--flower-x),-320rpx,0) rotate(var(--flower-angle)) scale(1.1)}}
@keyframes weight-celebration-message{0%{opacity:0;transform:translateY(15rpx) scale(.96)}12%{opacity:1;transform:translateY(0) scale(1)}78%{opacity:1}100%{opacity:0;transform:translateY(-12rpx) scale(1)}}
@media(prefers-reduced-motion:reduce){.celebration-spark,.celebration-flower{animation:none;display:none}.celebration-message{animation:none;transform:none}}

.weight-heading{align-items:flex-start}.weight-heading .weight-label{flex-shrink:0;padding-top:9rpx}.weight-heading-meta{display:flex;align-items:center;justify-content:flex-end;gap:12rpx;flex-wrap:wrap;min-width:0}.weight-plan{font-size:23rpx;font-weight:600;color:var(--weight-ink);padding:9rpx 0;line-height:1.5}.weight-heading .weight-status{white-space:nowrap}
.weight-value-row{align-items:center;gap:20rpx}.weight-column{flex:1;min-width:0}.weight-column-label{display:block;font-size:22rpx;font-weight:400;color:var(--weight-ink);opacity:.75;margin-bottom:12rpx}.weight-input-row,.weight-target-row{display:flex;align-items:baseline;gap:6rpx;min-height:100rpx}.weight-card .weight-input{flex:1;width:0;height:100rpx;font-size:76rpx;letter-spacing:-2rpx;min-width:0}.weight-card .weight-placeholder{font-size:30rpx;letter-spacing:0}.weight-target-value{font-size:76rpx;font-weight:700;letter-spacing:-2rpx;line-height:1.3;min-width:0;overflow-wrap:anywhere}.weight-value-row .weight-unit{font-size:23rpx;flex-shrink:0}.weight-mood{width:88rpx;height:88rpx}.weight-mood image{width:57rpx;height:57rpx}.weight-target-empty{display:flex;align-items:center;min-height:100rpx;font-size:25rpx;color:var(--weight-tone)}
.weight-heading .weight-plan{font-size:22rpx;font-weight:700;color:var(--weight-ink);background:var(--weight-soft);border:1rpx solid var(--weight-line);border-radius:24rpx;padding:8rpx 16rpx;line-height:1.4}.weight-value-row{gap:14rpx}.weight-column-label{font-size:23rpx;font-weight:600;opacity:.85}.weight-input-row{justify-content:flex-start;flex:none;gap:5rpx}.weight-input-wrap{position:relative;display:inline-block;flex:0 1 auto;min-width:0;max-width:calc(100% - 32rpx);height:100rpx}.weight-input-measure{display:block;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",sans-serif;font-size:76rpx;font-weight:700;letter-spacing:-2rpx;line-height:100rpx;white-space:pre;padding-right:3rpx;visibility:hidden;pointer-events:none}.weight-input-measure.is-empty{font-size:30rpx;letter-spacing:0}.weight-card .weight-input-wrap .weight-input{position:absolute;top:0;left:0;width:100%;height:100rpx;flex:none}.weight-direction{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:48rpx;height:48rpx;margin-top:31rpx;border-radius:50%;background:var(--weight-soft);color:var(--weight-tone)}.weight-direction-line{position:relative;width:26rpx;height:3rpx;border-radius:3rpx;background:var(--weight-tone)}.weight-direction-line::after{content:"";position:absolute;right:0;top:-5rpx;width:10rpx;height:10rpx;border-right:3rpx solid var(--weight-tone);border-top:3rpx solid var(--weight-tone);transform:rotate(45deg)}
/* Equal numeric columns around the arrow; encouragement icon retains its right-hand slot. */
.weight-value-row{display:grid;grid-template-columns:minmax(0,1fr) 48rpx minmax(0,1fr) 88rpx;gap:14rpx;align-items:center}.weight-column{text-align:center;width:100%;min-width:0}.weight-column-label{text-align:center}.weight-input-row,.weight-target-row{justify-content:center;align-items:center;gap:5rpx;height:100rpx;min-height:100rpx}.weight-target-value{line-height:100rpx}.weight-value-row .weight-unit{transform:translateY(18rpx);line-height:1.3}.weight-direction{margin-top:46rpx;justify-self:center}.weight-target-empty{justify-content:center;height:100rpx}.weight-feedback{display:block}
/* Yesterday, today, direction, target, and the existing encouragement icon. */
.weight-value-row{grid-template-columns:minmax(0,1fr) minmax(0,1fr) 36rpx minmax(0,1fr) 72rpx;gap:10rpx}.weight-column-label{font-size:21rpx}.weight-card .weight-input-wrap .weight-input,.weight-target-value,.weight-input-measure{font-size:62rpx;letter-spacing:-1.5rpx}.weight-input-measure.is-empty{font-size:25rpx;letter-spacing:0}.weight-card .weight-placeholder{font-size:25rpx}.weight-history-value{font-size:62rpx;letter-spacing:-1.5rpx;font-weight:700;line-height:100rpx}.weight-yesterday-column{opacity:.72}.weight-yesterday-empty{display:flex;align-items:center;justify-content:center;height:100rpx;font-size:22rpx;color:var(--weight-ink)}.weight-value-row .weight-unit{font-size:20rpx;transform:translateY(14rpx)}.weight-input-wrap{max-width:calc(100% - 27rpx)}.weight-input-row,.weight-target-row{gap:3rpx}.weight-direction{width:36rpx;height:36rpx}.weight-direction-line{width:21rpx}.weight-mood{width:72rpx;height:72rpx}.weight-mood image{width:50rpx;height:50rpx}.weight-target-empty{font-size:21rpx}
/* Match both directional icons between the three weight values. */
.weight-value-row{grid-template-columns:minmax(0,1fr) 30rpx minmax(0,1fr) 30rpx minmax(0,1fr) 64rpx;gap:8rpx}.weight-direction{width:30rpx;height:30rpx}.weight-direction-line{width:17rpx;height:2rpx}.weight-direction-line::after{width:8rpx;height:8rpx;top:-4rpx;border-right-width:2rpx;border-top-width:2rpx}.weight-mood{width:64rpx;height:64rpx}.weight-mood image{width:45rpx;height:45rpx}.weight-card .weight-input-wrap .weight-input,.weight-target-value,.weight-history-value,.weight-input-measure{font-size:56rpx}.weight-input-measure.is-empty,.weight-card .weight-placeholder{font-size:23rpx}.weight-column-label{font-size:20rpx}
.today-day{border:2rpx solid transparent}.today-day.training{background:#e1f5e7;color:#34734c}.today-day.rest{background:#fff0e0;color:#9b6335}.today-day.training .today-day-number,.today-day.rest .today-day-number{color:inherit}.today-day.current{box-shadow:0 5rpx 16rpx rgba(116,88,47,.06)}.today-day.current.training{background:#cbead4;border-color:#4f9668;color:#205d39}.today-day.current.rest{background:#ffe1bd;border-color:#d48a45;color:#a25a22}
.today-day{position:relative;padding-top:25rpx}.today-day-badge{position:absolute;top:-8rpx;right:-3rpx;min-width:27rpx;height:27rpx;line-height:27rpx;padding:0 4rpx;border-radius:8rpx;font-size:17rpx;font-weight:600;text-align:center;background:#d48a45;color:#fff}.today-day.training .today-day-badge{background:#3d8657}.today-day.rest .today-day-badge{background:#ca7e3c}

/* Compact date strip with more legible training/rest badges. */
.today-week{width:100%;gap:10rpx;margin:20rpx auto 24rpx}.today-day{padding:18rpx 2rpx 11rpx;gap:7rpx;font-size:18rpx;border-radius:22rpx}.today-day-number{font-size:24rpx}
/* Save action follows the same state palette as the weight card. */
.today-workout.training .primary{background:#3d8657;color:#fff}.today-workout.rest .primary{background:#ca7e3c;color:#fff}
.today-workout.training{background:#e1f5e7;color:#205d39}.today-workout.training .muted,.today-workout.training .workout-status{color:#34734c}.today-workout.training .tag{color:#34734c}.today-workout.training .sun-halo{border-color:rgba(111,182,135,.13);background:rgba(144,207,165,.18)}.today-workout.training .sun-halo::before{border-color:rgba(144,207,165,.2);background:rgba(235,250,239,.35)}.today-workout.rest{background:#fff0e0;color:#714323}.today-workout.rest .muted,.today-workout.rest .workout-status,.today-workout.rest .tag{color:#9b6335}
