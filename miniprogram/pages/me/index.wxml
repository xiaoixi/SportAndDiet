<view class="page"><view class="eyebrow">A LITTLE BETTER, EVERY DAY</view><view class="title">自己的节奏。</view><view class="card row"><view class="badge">练</view><view class="grow"><view style="font-size:34rpx;font-weight:600">{{profile ? '我的练食档案' : '你好，新朋友'}}</view><view class="muted">{{profile ? profile.goal + ' · 每周 ' + profile.days.length + ' 次' : '从一份适合自己的计划开始'}}</view></view></view><view class="card"><view class="row list-item" bindtap="profile"><text>个人档案与计划调整</text><text>›</text></view><view class="row list-item" bindtap="privacy"><text>隐私与数据说明</text><text>›</text></view><view class="row list-item" bindtap="exportData"><text>导出我的数据</text><text>›</text></view></view><view class="card"><view>保存与同步</view><view class="muted space">{{status.label}}</view><button wx:if="{{!status.connected}}" class="dark space" loading="{{busy}}" disabled="{{busy}}" bindtap="login">连接微信云端账户</button><button wx:elif="{{status.conflict}}" class="dark space" bindtap="resolve">选择保留的数据版本</button><button wx:else class="secondary space" bindtap="sync">立即同步</button><view class="caption">本地模式无需登录；连接云端需项目已配置 AppID 与云环境。</view><button class="link space" bindtap="content">更新已发布内容库</button></view><view class="card"><view class="row list-item" bindtap="clear"><text>删除全部执行记录</text><text>›</text></view><view class="row list-item" bindtap="remove"><text style="color:#a7432b">注销账户并清除数据</text><text>›</text></view><view class="row list-item" bindtap="admin"><text>内容管理（管理员）</text><text>›</text></view></view><view class="footer-note">练食日记 v1.0 · 今天也好好照顾自己</view></view>
