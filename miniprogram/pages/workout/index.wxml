<view class="page"><view class="eyebrow">MOVEMENT / {{date}}</view><view wx:if="{{!plan}}" class="empty">未找到当天计划，请先建立档案。</view><block wx:elif="{{!plan.training}}"><view class="title">今天，好好恢复。</view><view class="card hero"><view class="hero-title">休息也是进步。</view><view>按自己的感受选择轻松活动，或安心休息。今天不计入训练完成率。</view></view></block><block wx:else><view class="title">{{plan.title}}</view><view class="subtitle">{{plan.minutes}} 分钟 · 无器械 · {{session ? session.status : '未开始'}}</view><view class="notice" wx:if="{{future}}">这是未来计划，可以先了解动作，当天再开始。</view><view class="card hero" wx:if="{{session}}"><view class="row"><view><view class="muted">{{session.runningSince ? '训练进行中' : '已暂停 / 结束'}}</view><view class="big number">{{elapsed}}</view></view><view><view class="muted">完成组数</view><view class="big">{{done}}<text class="small"> / {{total}}</text></view></view></view><view class="space" wx:if="{{rest}}">组间休息 · {{rest}} 秒</view><button wx:if="{{session.status === '进行中'}}" class="primary space" bindtap="toggle">{{session.runningSince ? '暂停计时' : '继续训练'}}</button></view>
<view class="card" wx:for="{{session ? session.exercises : plan.exercises}}" wx:key="id" wx:for-index="exerciseIndex"><view class="row"><text class="tag">{{item.phase}} · {{item.part}}</text><text class="muted">{{item.equipment}}</text></view><view class="section" style="margin:18rpx 0">{{item.name}}</view><image class="exercise-image" src="{{item.image}}" mode="aspectFit"/><view class="row space"><text>{{item.sets}} 组 × {{item.reps}} {{item.unit}}</text><button class="link" bindtap="details" data-id="{{item.id}}">动作说明 ↗</button></view><view class="muted small">{{item.caution}}</view><block wx:if="{{session}}"><view class="space">{{item.skipped ? '已跳过' : '已记录 ' + item.logs.length + ' / ' + item.sets + ' 组'}}</view><view class="small muted" wx:for="{{item.logs}}" wx:for-item="log" wx:key="at">第 {{index + 1}} 组：{{log.amount}} {{item.unit}} · {{log.weight}} kg</view><block wx:if="{{session.status === '进行中'}}"><input class="space" type="digit" placeholder="负重 kg（可选，默认 0）" bindinput="weight" data-index="{{exerciseIndex}}"/><button class="dark space" disabled="{{item.skipped || item.logs.length >= item.sets || !session.runningSince}}" data-index="{{exerciseIndex}}" bindtap="log">记录完成一组</button><view class="actions"><button class="secondary" bindtap="skip" data-index="{{exerciseIndex}}">{{item.skipped ? '取消跳过' : '跳过动作'}}</button><button class="secondary" disabled="{{item.logs.length > 0}}" bindtap="replace" data-index="{{exerciseIndex}}">替换动作</button></view></block></block></view>
<block wx:if="{{!session}}"><button class="dark space" bindtap="start" disabled="{{future}}">开始训练</button><button class="link space" bindtap="skipDay" disabled="{{future}}">今天跳过，不自动补练</button></block><block wx:elif="{{session.status === '进行中'}}"><view class="card"><text class="label">这次感觉如何？</text><text wx:for="{{['轻松','适中','偏难']}}" wx:key="*this" class="pill {{session.feeling === item ? 'active' : ''}}" data-value="{{item}}" bindtap="feeling">{{item}}</text><textarea class="space" value="{{session.note}}" bindblur="note" placeholder="留一句训练感受（选填）" maxlength="300"/></view><button class="dark space" bindtap="end">结束并保存训练</button><button class="link space" bindtap="discomfort">出现不适，停止训练</button></block><view wx:else class="card summary">本次训练已保存 · {{session.feeling}}<view class="muted">{{session.note || '每次认真对待自己，都有意义。'}}</view></view></block></view>
